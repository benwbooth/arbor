diff --git a/src/wayland_outputs.rs b/src/wayland_outputs.rs
new file mode 100644
index 0000000..0f623ef
--- /dev/null
+++ b/src/wayland_outputs.rs
@@ -0,0 +1,301 @@
+//! Output enumeration over standard Wayland protocols (wl_output v4 +
+//! xdg-output), for compositors without Hyprland IPC such as arbor.
+//!
+//! The result has the shape of Hyprland's `j/monitors` so the existing
+//! callers work unchanged: `name`, `x`/`y` (logical position), `width`/
+//! `height` (current mode in physical pixels) and `scale`.
+
+use anyhow::{Context, Result};
+use serde_json::{json, Value};
+use wayland_client::globals::{registry_queue_init, GlobalListContents};
+use wayland_client::protocol::{wl_output, wl_registry};
+use wayland_client::{Connection, Dispatch, Proxy as _, QueueHandle, WEnum};
+use wayland_protocols::xdg::xdg_output::zv1::client::{
+    zxdg_output_manager_v1::ZxdgOutputManagerV1, zxdg_output_v1, zxdg_output_v1::ZxdgOutputV1,
+};
+
+#[derive(Clone, Debug, Default, PartialEq)]
+pub(crate) struct OutputInfo {
+    pub(crate) name: Option<String>,
+    /// Current mode, physical pixels, untransformed.
+    pub(crate) mode: Option<(i32, i32)>,
+    pub(crate) rotated: bool,
+    pub(crate) integer_scale: i32,
+    pub(crate) logical_position: Option<(i32, i32)>,
+    pub(crate) logical_size: Option<(i32, i32)>,
+}
+
+#[derive(Default)]
+struct State {
+    outputs: Vec<OutputInfo>,
+}
+
+impl Dispatch<wl_registry::WlRegistry, GlobalListContents> for State {
+    fn event(
+        _: &mut Self,
+        _: &wl_registry::WlRegistry,
+        _: wl_registry::Event,
+        _: &GlobalListContents,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+    }
+}
+
+impl Dispatch<wl_output::WlOutput, usize> for State {
+    fn event(
+        state: &mut Self,
+        _: &wl_output::WlOutput,
+        event: wl_output::Event,
+        index: &usize,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        let Some(info) = state.outputs.get_mut(*index) else {
+            return;
+        };
+        match event {
+            wl_output::Event::Geometry { transform, .. } => {
+                info.rotated = matches!(
+                    transform,
+                    WEnum::Value(
+                        wl_output::Transform::_90
+                            | wl_output::Transform::_270
+                            | wl_output::Transform::Flipped90
+                            | wl_output::Transform::Flipped270
+                    )
+                );
+            }
+            wl_output::Event::Mode {
+                flags,
+                width,
+                height,
+                ..
+            } => {
+                if let WEnum::Value(flags) = flags {
+                    if flags.contains(wl_output::Mode::Current) {
+                        info.mode = Some((width, height));
+                    }
+                }
+            }
+            wl_output::Event::Scale { factor } => info.integer_scale = factor,
+            wl_output::Event::Name { name } => info.name = Some(name),
+            _ => {}
+        }
+    }
+}
+
+impl Dispatch<ZxdgOutputManagerV1, ()> for State {
+    fn event(
+        _: &mut Self,
+        _: &ZxdgOutputManagerV1,
+        _: <ZxdgOutputManagerV1 as wayland_client::Proxy>::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+    }
+}
+
+impl Dispatch<ZxdgOutputV1, usize> for State {
+    fn event(
+        state: &mut Self,
+        _: &ZxdgOutputV1,
+        event: zxdg_output_v1::Event,
+        index: &usize,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        let Some(info) = state.outputs.get_mut(*index) else {
+            return;
+        };
+        match event {
+            zxdg_output_v1::Event::LogicalPosition { x, y } => {
+                info.logical_position = Some((x, y));
+            }
+            zxdg_output_v1::Event::LogicalSize { width, height } => {
+                info.logical_size = Some((width, height));
+            }
+            // wl_output v4 already names the output; xdg-output v2 is the
+            // fallback for older wl_output binds.
+            zxdg_output_v1::Event::Name { name } => {
+                info.name.get_or_insert(name);
+            }
+            _ => {}
+        }
+    }
+}
+
+/// Query the compositor's outputs in Hyprland `j/monitors` shape.
+pub(crate) fn monitors() -> Result<Value> {
+    let conn = Connection::connect_to_env().context("failed to connect to Wayland display")?;
+    let (globals, mut queue) =
+        registry_queue_init::<State>(&conn).context("failed to read Wayland globals")?;
+    let qh = queue.handle();
+    let mut state = State::default();
+
+    let output_globals: Vec<(u32, u32)> = globals.contents().with_list(|list| {
+        list.iter()
+            .filter(|global| global.interface == "wl_output")
+            .map(|global| (global.name, global.version))
+            .collect()
+    });
+    let registry = globals.registry();
+    let mut wl_outputs = Vec::with_capacity(output_globals.len());
+    for (index, (name, version)) in output_globals.into_iter().enumerate() {
+        state.outputs.push(OutputInfo::default());
+        wl_outputs.push(registry.bind::<wl_output::WlOutput, _, _>(
+            name,
+            version.min(4),
+            &qh,
+            index,
+        ));
+    }
+
+    let xdg_manager = globals
+        .bind::<ZxdgOutputManagerV1, _, _>(&qh, 1..=3, ())
+        .ok();
+    let xdg_outputs: Vec<ZxdgOutputV1> = match &xdg_manager {
+        Some(manager) => wl_outputs
+            .iter()
+            .enumerate()
+            .map(|(index, output)| manager.get_xdg_output(output, &qh, index))
+            .collect(),
+        None => Vec::new(),
+    };
+
+    queue
+        .roundtrip(&mut state)
+        .context("Wayland roundtrip for outputs failed")?;
+    queue
+        .roundtrip(&mut state)
+        .context("Wayland roundtrip for outputs failed")?;
+
+    for xdg_output in xdg_outputs {
+        xdg_output.destroy();
+    }
+    if let Some(manager) = xdg_manager {
+        manager.destroy();
+    }
+    for output in wl_outputs {
+        if output.version() >= 3 {
+            output.release();
+        }
+    }
+    let _ = conn.flush();
+
+    Ok(monitors_json(&state.outputs))
+}
+
+/// Convert enumerated outputs into Hyprland's monitor JSON shape. Outputs
+/// without a name or current mode are skipped.
+pub(crate) fn monitors_json(outputs: &[OutputInfo]) -> Value {
+    Value::Array(
+        outputs
+            .iter()
+            .filter_map(|info| {
+                let name = info.name.as_ref()?;
+                let (width, height) = info.mode?;
+                let (x, y) = info.logical_position.unwrap_or((0, 0));
+                // Fractional scale is physical width over logical width
+                // (in the output's transformed orientation); wl_output's
+                // integer scale is only the rounded-up hint.
+                let transformed_width = if info.rotated { height } else { width };
+                let scale = match info.logical_size {
+                    Some((logical_w, _)) if logical_w > 0 => {
+                        f64::from(transformed_width) / f64::from(logical_w)
+                    }
+                    _ => f64::from(info.integer_scale.max(1)),
+                };
+                Some(json!({
+                    "name": name,
+                    "x": x,
+                    "y": y,
+                    "width": width,
+                    "height": height,
+                    "scale": scale,
+                }))
+            })
+            .collect(),
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn dp1() -> OutputInfo {
+        // The arbor desktop: 5120x2160 panel at scale 4/3 (3840x1620 logical).
+        OutputInfo {
+            name: Some("DP-1".into()),
+            mode: Some((5120, 2160)),
+            rotated: false,
+            integer_scale: 2,
+            logical_position: Some((0, 0)),
+            logical_size: Some((3840, 1620)),
+        }
+    }
+
+    #[test]
+    fn fractional_scale_comes_from_logical_size() {
+        let monitors = monitors_json(&[dp1()]);
+        let m = &monitors[0];
+        assert_eq!(m["name"], "DP-1");
+        assert_eq!(m["width"], 5120);
+        assert_eq!(m["height"], 2160);
+        assert_eq!(m["x"], 0);
+        let scale = m["scale"].as_f64().unwrap();
+        assert!((scale - 4.0 / 3.0).abs() < 1e-9, "scale {scale}");
+    }
+
+    #[test]
+    fn unnamed_or_modeless_outputs_are_skipped_and_integer_scale_is_fallback() {
+        let unnamed = OutputInfo {
+            name: None,
+            ..dp1()
+        };
+        let modeless = OutputInfo {
+            name: Some("HDMI-A-1".into()),
+            mode: None,
+            ..dp1()
+        };
+        let no_xdg = OutputInfo {
+            name: Some("eDP-1".into()),
+            mode: Some((2880, 1800)),
+            rotated: false,
+            integer_scale: 2,
+            logical_position: None,
+            logical_size: None,
+        };
+        let monitors = monitors_json(&[unnamed, modeless, no_xdg]);
+        let arr = monitors.as_array().unwrap();
+        assert_eq!(arr.len(), 1);
+        assert_eq!(arr[0]["name"], "eDP-1");
+        assert_eq!(arr[0]["scale"].as_f64(), Some(2.0));
+    }
+
+    #[test]
+    fn rotated_output_scale_uses_transformed_width() {
+        let rotated = OutputInfo {
+            name: Some("DP-2".into()),
+            mode: Some((3840, 2160)),
+            rotated: true,
+            integer_scale: 2,
+            logical_position: Some((3840, 0)),
+            logical_size: Some((1080, 1920)),
+        };
+        let monitors = monitors_json(&[rotated]);
+        assert_eq!(monitors[0]["scale"].as_f64(), Some(2.0));
+        assert_eq!(monitors[0]["x"], 3840);
+    }
+
+    #[test]
+    fn arbor_output_feeds_the_input_layout_in_physical_pixels() {
+        // The virtual pointer is bound to the output and its absolute extents
+        // are the output's physical size; the compositor maps x/x_extent onto
+        // the output's logical rectangle, so scale 4/3 needs no correction.
+        let monitors = monitors_json(&[dp1()]);
+        let layout = crate::input::layout_from_monitors_for_test(&monitors, "DP-1").unwrap();
+        assert_eq!(layout, (5120, 2160, 5120, 2160, 0, 0));
+    }
+}
